# Pinned image versions: the single place for them (R7).
# Plain KEY=value lines, no quotes, so Compose (--env-file) and bash (source) read them the same way.
# Every reference is "tag@digest" (index digest, multi-arch). Never "latest".
# To change one: look up the new tag, take its digest with
#   docker buildx imagetools inspect <image>:<tag>
# and update the value and the date comment together.

# Base image of postgres/Dockerfile (docs/decisions/0001-postgis-image.md), observed 2026-10-28.
POSTGRES_IMAGE=postgres:18-trixie@sha256:979bccfde35445db618c65107d27d08c6c21339d8dc3ad4c830c6633947be0e4
# PGDG apt version of postgresql-18-postgis-3, installed on top of POSTGRES_IMAGE. PGDG drops old versions
# from its index, so a failing build here means this pin needs a refresh.
POSTGIS_PACKAGE_VERSION=3.6.4+dfsg-2.pgdg13+1

# axllent/mailpit v1.32.0 (amd64, arm64), observed 2026-10-28. The tag is confirmed again in P1-T3.
MAILPIT_IMAGE=axllent/mailpit:v1.32.0@sha256:0790692be935ea4420d085694f7985b1f692ca6a8771ab0e0bd8ba75ac180498

# SeaweedFS 4.51 run as "weed mini" (docs/decisions/0002-s3-emulator.md), observed 2026-10-28.
# Fallback: dxflrs/garage:v2.5.0@sha256:677e5b758e4425a325b811c425c026bf35a4bf42f7ddbaa773de3f4fd779a5a5
S3_IMAGE=chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8

# Caddy 2.11.7 on Alpine (amd64, arm64), observed 2026-10-28. Must match infra/ in the monorepo (R11);
# check-parity.sh (P5-T4) compares them. Used by profile "apps" only.
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f

# API image tag: supplied by the monorepo (its CI publishes the image, see docs/api-contract.md). The value below
# is a placeholder that is not published: it only keeps `docker compose config` valid, and `scripts/up.sh --apps`
# fails to pull it until a real tag replaces it.
API_TAG=0.0.0-unpublished
