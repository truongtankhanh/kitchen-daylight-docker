# Manifest for Dependabot only (docs/5-test-stack-and-ci.md, 5.4). It is never built.
# Dependabot cannot read versions.env, so the base images are listed here as FROM lines.
# Keep every line equal to the matching *_IMAGE value in versions.env (R7): when Dependabot
# opens a pull request for this file, copy the new "tag@digest" into versions.env in the same
# pull request, so that the smoke workflow tests it. The gitleaks line must equal the image of
# .github/workflows/secrets.yml. The lint workflow fails when any line drifts.
FROM postgres:18-trixie@sha256:979bccfde35445db618c65107d27d08c6c21339d8dc3ad4c830c6633947be0e4 AS postgres
FROM axllent/mailpit:v1.33.1@sha256:aef2aacc11f075ec0fb6874275ee4a421e688e11a96ebb296134d1735c7761ce AS mailpit
FROM chrislusf/seaweedfs:4.51@sha256:f7a49e3f3972ebed5be2ed4befa4a0c68eb7bdddba6e692d42729ceb545134b8 AS s3
FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f AS caddy
FROM ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f AS gitleaks
