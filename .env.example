# Template for .env and .env.test. Do not copy it by hand: run scripts/init-env.sh <slot>.
# The values below are for slot 2 (every port = base + slot x 10). The generated .env is not committed.
# Every credential here is a local placeholder and must never be reused outside a local machine.

COMPOSE_PROJECT_NAME=kd-docker
KD_SLOT=2
APP_ENV=dev

# PostgreSQL (database name: kd_dev for the dev stack, kd_test for the test stack)
KD_DATABASE=kd_dev
POSTGRES_PORT=5452
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_LOCAL
KD_MIGRATOR_PASSWORD=CHANGE_ME_LOCAL
KD_APP_PASSWORD=CHANGE_ME_LOCAL

# Mailpit
MAILPIT_SMTP_PORT=1045
MAILPIT_UI_PORT=8045

# S3 emulator
S3_PORT=9020
S3_CONSOLE_PORT=9021
S3_ACCESS_KEY=CHANGE_ME_LOCAL
S3_SECRET_KEY=CHANGE_ME_LOCAL

# Profile "apps"
API_PORT=3020
CADDY_PORT=8020
OTP_HMAC_SECRET=CHANGE_ME_LOCAL
# scripts/gen-dev-secrets.sh adds JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (an ES256 pair, base64 of the PEM, one line) and
# JWT_KEY_ID to .env, and replaces the OTP_HMAC_SECRET placeholder above with a random value (ADR-0003). They are
# not listed here on purpose: the API refuses to start without them.
# The API image commands (docs/api-contract.md). Uncomment to override the defaults of compose.apps.yaml and
# scripts/seed.sh; keep the quotes, because scripts load this file with bash.
# API_MIGRATE_CMD="node dist/cli.js migrate"
# API_SEED_CMD="node dist/cli.js seed"
# The admin build that Caddy serves at / (mounted read-only as /srv). Default: the placeholder page in caddy/placeholder.
# A relative path is resolved against the folder of compose.apps.yaml; the folder must exist.
# ADMIN_DIST=/absolute/path/to/the/admin/dist
